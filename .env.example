# --- DB ---
META_DSN=postgresql://USER:PASSWORD@192.168.0.140:5432/ggydb
BIZ_DSN=postgresql://USER:PASSWORD@192.168.0.140:5432/ggydb
BIZ_SCHEMA=biz
META_SCHEMA=meta

# --- LLM ---
OLLAMA_BASE_URL=http://192.168.0.169:11434
LLM_MODEL=gemma4:26b-a4b-it-q4_K_M
LLM_TIMEOUT_SEC=300

# --- Embedding ---
EMBED_PROVIDER=ollama
EMBED_MODEL=bge-m3:latest
EMBED_DIM=1024
EMBED_BATCH=16

# --- 수집 ---
VALUE_DISTINCT_MAX=50
SAMPLE_VALUE_COUNT=5

# --- 검색 튜닝 ---
RRF_K=60
W_VALUE=3.0
W_VECTOR_COL=1.0
W_VECTOR_TBL=1.0
W_KEYWORD=0.7
TOP_TABLES=2
SCORE_CUTOFF_RATIO=0.2
MIN_TABLE_SCORE=0.0
MIN_TOKEN_IDF=0.5
MAX_HITS_PER_TABLE=3
MAX_CONTEXT_TABLES=8
JOIN_MAX_DEPTH=3
TRGM_MIN_SIMILARITY=0.7

# --- SQL 실행 ---
COLLECT_TIMEOUT_SEC=120

# --- 백엔드 / MCP ---
# Streamlit·CLI 가 질문을 보낼 백엔드 주소
API_URL=http://127.0.0.1:8000
# SQL 실행 MCP 서버. uvicorn 프로세스만 사용한다.
MCP_URL=http://127.0.0.1:8100/mcp
# .env.mcp 의 MCP_AUTH_TOKEN 과 같은 값이어야 한다.
MCP_AUTH_TOKEN=change-me
# .env.mcp 의 SQL_TIMEOUT_SEC 보다 커야 한다.
MCP_TIMEOUT_SEC=30

# --- 디버그 ---
# true면 DB로 보내는 SQL과 반환 행을 실행 터미널(stderr)에 출력한다.
SQL_ECHO=false
SQL_ECHO_ROWS=5
SQL_ECHO_MAXLEN=2000
